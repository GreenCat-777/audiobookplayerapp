<Window x:Class="AudiobookPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AudiobookPlayer"
        Title="Audiobook Player" Width="1120" Height="800" MinWidth="900" MinHeight="660"
        Background="{StaticResource InkBrush}" Foreground="{StaticResource PaperBrush}"
        FontFamily="Segoe UI" AllowDrop="True" UseLayoutRounding="True">

    <Window.Resources>

        <!-- Sidebar: section header -->
        <DataTemplate DataType="{x:Type local:SectionHeaderVM}">
            <TextBlock Text="{Binding Title}" Margin="16,16,16,4" FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource DimBrush}" TextTrimming="CharacterEllipsis"/>
        </DataTemplate>

        <!-- Sidebar: book row -->
        <DataTemplate DataType="{x:Type local:BookRowVM}">
            <Border x:Name="Row" Margin="8,1" Padding="6,5" CornerRadius="8" Background="Transparent"
                    Cursor="Hand" MouseLeftButtonUp="BookRow_Click">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Play" Click="BookPlay_Click"/>
                        <MenuItem Header="Show in Explorer" Click="BookReveal_Click"/>
                        <Separator/>
                        <MenuItem Header="Remove custom cover" Click="BookRemoveCover_Click"
                                  Visibility="{Binding HasCustomCover, Converter={StaticResource BoolVis}}"/>
                        <MenuItem Header="Reset progress" Click="BookReset_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="34" Height="44" CornerRadius="4" BorderThickness="1" BorderBrush="#1AFFFFFF"
                            Background="#0FFFFFFF" VerticalAlignment="Center">
                        <Grid>
                            <Border CornerRadius="3">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <TextBlock Text="&#xE8F1;" Style="{StaticResource Glyph}" FontSize="14"
                                       Foreground="#59F0EBE0" HorizontalAlignment="Center"
                                       Visibility="{Binding Cover, Converter={StaticResource NullToVis}}"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="12.5" TextWrapping="Wrap"
                                   MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Subtitle}" FontFamily="Consolas" FontSize="10"
                                   Foreground="{StaticResource DimBrush}" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar Style="{StaticResource ThinProgress}" Minimum="0" Maximum="1"
                                     Value="{Binding Progress}" Margin="0,3,0,0"
                                     Visibility="{Binding ShowProgress, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="&#xE767;" Style="{StaticResource Glyph}" FontSize="13"
                               Foreground="{StaticResource GoldBrush}" Margin="0,0,4,0"
                               Visibility="{Binding IsPlaying, Converter={StaticResource BoolVis}}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="#0FFFFFFF"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="#24C8A96E"/>
                    <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource GoldBrush}"/>
                    <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Chapter row -->
        <DataTemplate DataType="{x:Type local:ChapterRowVM}">
            <Border x:Name="Row" Margin="0,1" Padding="10,7" CornerRadius="7" Background="Transparent"
                    Cursor="Hand" MouseLeftButtonUp="Chapter_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding NumberText}" FontFamily="Consolas" FontSize="10"
                               Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="T" Grid.Column="1" Text="{Binding Title}" FontSize="12.5"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontFamily="Consolas" FontSize="10"
                               Foreground="{StaticResource FaintBrush}" Margin="8,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="&#xE767;" Style="{StaticResource Glyph}" FontSize="12"
                               Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Right"
                               Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Grid.Column="3" Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="12"
                               Foreground="#80C8A96E" HorizontalAlignment="Right"
                               Visibility="{Binding IsDone, Converter={StaticResource BoolVis}}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="#0FFFFFFF"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="#24C8A96E"/>
                    <Setter TargetName="T" Property="Foreground" Value="{StaticResource GoldBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Bookmark row -->
        <DataTemplate DataType="{x:Type local:BookmarkVM}">
            <Border x:Name="Row" Margin="0,3" Padding="12,10" CornerRadius="9" Background="#0DFFFFFF"
                    BorderBrush="#14FFFFFF" BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="Bookmark_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE8A4;" Style="{StaticResource Glyph}" FontSize="14" Foreground="#CCC8A96E"
                               VerticalAlignment="Top" Margin="0,1,10,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Meta}" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource DimBrush}"/>
                        <TextBlock Text="{Binding Note}" FontFamily="Georgia" FontStyle="Italic" FontSize="11.5"
                                   Foreground="{StaticResource DimBrush}" TextWrapping="Wrap" Margin="0,3,0,0"
                                   Visibility="{Binding HasNote, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                    <Button x:Name="Del" Grid.Column="2" Style="{StaticResource IconBtn}" Width="26" Height="26" FontSize="10"
                            Content="&#xE711;" Opacity="0" ToolTip="Delete bookmark" Click="BookmarkDelete_Click"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="#17FFFFFF"/>
                    <Setter TargetName="Del" Property="Opacity" Value="1"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Speed chip in the popup -->
        <DataTemplate x:Key="SpeedChip">
            <Button Style="{StaticResource PillButton}" Margin="0,0,6,6" Width="52" Click="SpeedItem_Click">
                <TextBlock Text="{Binding StringFormat='{}{0:0.##}x'}"/>
            </Button>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═════════ Sidebar ═════════ -->
        <Grid Grid.Column="0" Background="{StaticResource PanelBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="18,16,10,4">
                <TextBlock Text="Audiobook Player" FontFamily="Georgia" FontStyle="Italic" FontSize="18"
                           Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconBtn}" Width="34" Height="34" FontSize="15" Content="&#xE8B7;"
                            ToolTip="Open library folder (Ctrl+O)" Click="OpenLibrary_Click"/>
                    <Button Style="{StaticResource IconBtn}" Width="34" Height="34" FontSize="15" Content="&#xE713;"
                            ToolTip="Settings (Ctrl+,)" Click="Settings_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="14,8,14,6">
                <TextBox x:Name="SearchBox" Style="{StaticResource DarkTextBox}" Padding="10,7" TextChanged="Search_Changed"/>
                <TextBlock x:Name="SearchPlaceholder" Text="Search library" IsHitTestVisible="False"
                           Foreground="{StaticResource FaintBrush}" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="13"/>
            </Grid>

            <ListBox Grid.Row="2" ItemsSource="{Binding Sidebar}" ItemContainerStyle="{StaticResource PlainItem}"
                     Background="Transparent" BorderThickness="0" Focusable="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingStackPanel.IsVirtualizing="True"/>

            <TextBlock Grid.Row="2" Text="{Binding SidebarHint}" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource DimBrush}" FontSize="12" Margin="24" VerticalAlignment="Center"
                       Visibility="{Binding ShowSidebarHint, Converter={StaticResource BoolVis}}"/>

            <Border Grid.Row="3" Background="#FF171A21" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0" Padding="16,10"
                    Visibility="{Binding ShowFooter, Converter={StaticResource BoolVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" FontSize="16" Foreground="{StaticResource GoldBrush}" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LibraryName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding BookCountText}" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource DimBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource IconBtn}" Width="30" Height="30" FontSize="13"
                            Content="&#xE72C;" ToolTip="Rescan library (Ctrl+R)" Click="Rescan_Click"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ═════════ Detail ═════════ -->
        <Grid Grid.Column="1" ClipToBounds="True">

            <!-- backdrop from the cover art -->
            <Grid IsHitTestVisible="False" Visibility="{Binding HasBook, Converter={StaticResource BoolVis}}">
                <Image Source="{Binding BackdropCover}" Stretch="UniformToFill" Opacity="0.6"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <BlurEffect Radius="30" KernelType="Gaussian"/>
                    </Image.Effect>
                </Image>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1A0D0F14" Offset="0"/>
                            <GradientStop Color="#D00D0F14" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>

            <!-- welcome / empty states -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="460"
                        Visibility="{Binding HasBook, Converter={StaticResource InvBoolVis}}">
                <TextBlock Text="{Binding WelcomeGlyph}" Style="{StaticResource Glyph}" FontSize="60"
                           Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding WelcomeTitle}" FontFamily="Georgia" FontStyle="Italic" FontSize="32"
                           HorizontalAlignment="Center" Margin="0,14,0,0"/>
                <TextBlock Text="{Binding WelcomeMessage}" TextAlignment="Center" TextWrapping="Wrap" FontSize="13"
                           Foreground="{StaticResource DimBrush}" LineHeight="21" Margin="0,14,0,0"/>

                <Button Content="Open Library Folder..." Click="OpenLibrary_Click" Margin="0,22,0,0" HorizontalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GoldBtn}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WelcomeMode}" Value="none">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WelcomeMode}" Value="empty">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Content="Rescan" Style="{StaticResource GoldBtn}" Click="Rescan_Click"/>
                    <Button Content="Change folder..." Style="{StaticResource GhostBtn}" Click="OpenLibrary_Click"/>
                    <Button Content="Show in Explorer" Style="{StaticResource GhostBtn}" Click="ShowLibraryFolder_Click"/>
                </StackPanel>
            </StackPanel>

            <!-- now playing -->
            <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding HasBook, Converter={StaticResource BoolVis}}">
                <StackPanel Width="470" Margin="0,36,0,40" HorizontalAlignment="Center">

                    <!-- cover -->
                    <Grid Width="274" Height="274" HorizontalAlignment="Center">
                        <Border CornerRadius="22" BorderThickness="2" BorderBrush="{StaticResource GoldBrush}" IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.5"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.5"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <Border Width="254" Height="254" CornerRadius="18" BorderThickness="1" BorderBrush="#1FFFFFFF" Background="#0DFFFFFF">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="40" ShadowDepth="14" Direction="270" Opacity="0.55" Color="Black"/>
                            </Border.Effect>
                            <Grid>
                                <Border CornerRadius="17">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Visibility="{Binding Cover, Converter={StaticResource NullToVis}}">
                                    <TextBlock Text="&#xE8F1;" Style="{StaticResource Glyph}" FontSize="46"
                                               Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="No cover art" FontFamily="Georgia" FontStyle="Italic" FontSize="13"
                                               Foreground="{StaticResource FaintBrush}" Margin="0,8,0,0"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                                        Background="#A6000000" CornerRadius="15">
                                    <Button Style="{StaticResource IconBtn}" Width="30" Height="30" FontSize="13" Content="&#xE91B;"
                                            ToolTip="Change cover art" Click="ChangeCover_Click"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- title block -->
                    <TextBlock Text="{Binding BookTitle}" FontFamily="Georgia" FontSize="28" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,26,0,0"/>
                    <TextBlock Text="{Binding BookAuthor}" FontFamily="Georgia" FontStyle="Italic" FontSize="15"
                               Foreground="#B3F0EBE0" TextAlignment="Center" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding NarratorText}" FontSize="11" Foreground="{StaticResource DimBrush}"
                               TextAlignment="Center" Margin="0,4,0,0"
                               Visibility="{Binding HasNarrator, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="{Binding ChapterTitle}" FontFamily="Georgia" FontStyle="Italic" FontSize="14"
                               Foreground="{StaticResource GoldBrush}" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                               Margin="0,12,0,0"/>
                    <TextBlock Text="{Binding ChapterLabel}" FontFamily="Consolas" FontSize="10"
                               Foreground="{StaticResource DimBrush}" TextAlignment="Center" Margin="0,2,0,0"/>

                    <!-- chapter scrubber -->
                    <Grid Margin="0,26,0,0">
                        <TextBlock Text="{Binding ChapterElapsedText}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource DimBrush}"/>
                        <TextBlock Text="{Binding ChapterLengthText}" FontFamily="Consolas" FontSize="11"
                                   Foreground="{StaticResource DimBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                    <local:Scrubber x:Name="ChapterScrub" Fraction="{Binding ChapterFraction, Mode=OneWay}" Margin="0,2,0,0"/>

                    <!-- controls -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                        <Button Style="{StaticResource IconBtn}" FontSize="15" Content="&#xE892;" ToolTip="Previous chapter  [" Click="Prev_Click"/>
                        <Button Style="{StaticResource SkipBtn}" Content="&#x21BA;60" ToolTip="Back 1 minute  Shift+Left" Click="Back60_Click"/>
                        <Button Style="{StaticResource SkipBtn}" Content="{Binding SkipBackLabel}" ToolTip="Skip back  Left" Click="SkipBack_Click"/>
                        <Button Style="{StaticResource PlayBtn}" Content="{Binding PlayGlyph}" Margin="10,0" ToolTip="Play / pause  Space" Click="PlayPause_Click"/>
                        <Button Style="{StaticResource SkipBtn}" Content="{Binding SkipForwardLabel}" ToolTip="Skip forward  Right" Click="SkipForward_Click"/>
                        <Button Style="{StaticResource SkipBtn}" Content="60&#x21BB;" ToolTip="Forward 1 minute  Shift+Right" Click="Forward60_Click"/>
                        <Button Style="{StaticResource IconBtn}" FontSize="15" Content="&#xE893;" ToolTip="Next chapter  ]" Click="Next_Click"/>
                    </StackPanel>

                    <!-- whole-book bar -->
                    <StackPanel Margin="0,18,0,0" Visibility="{Binding ShowBookBar, Converter={StaticResource BoolVis}}">
                        <local:Scrubber x:Name="BookScrub" Thickness="3" ThumbSize="10" Fraction="{Binding BookFraction, Mode=OneWay}"/>
                        <Grid>
                            <TextBlock Text="{Binding BookPercentText}" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource DimBrush}"/>
                            <TextBlock Text="{Binding BookLeftText}" FontFamily="Consolas" FontSize="10"
                                       Foreground="{StaticResource DimBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>

                    <!-- speed / volume / sleep -->
                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="SpeedBtn" Grid.Column="0" HorizontalAlignment="Left" Style="{StaticResource PillButton}"
                                local:Ui.IsActive="{Binding SpeedActive}" Content="{Binding SpeedLabel}" Click="Speed_Click" ToolTip="Playback speed (Ctrl +/-)"/>
                        <Popup x:Name="SpeedPopup" PlacementTarget="{Binding ElementName=SpeedBtn}" Placement="Top"
                               StaysOpen="False" AllowsTransparency="True" VerticalOffset="-6">
                            <Border Background="#FF1B1E26" BorderBrush="#2EFFFFFF" BorderThickness="1" CornerRadius="10" Padding="14,12,8,6" Margin="8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="Playback speed" FontFamily="Georgia" FontStyle="Italic" FontSize="14" Margin="0,0,0,10"/>
                                    <ItemsControl ItemsSource="{x:Static local:Player.Speeds}" ItemTemplate="{StaticResource SpeedChip}" Width="244">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE992;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{StaticResource DimBrush}" Margin="0,0,8,0"/>
                            <local:Scrubber x:Name="VolumeScrub" Width="100" Thickness="4" ThumbSize="12" Fraction="{Binding Volume, Mode=OneWay}"/>
                            <TextBlock Text="&#xE995;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{StaticResource DimBrush}" Margin="8,0,0,0"/>
                        </StackPanel>

                        <Button x:Name="SleepBtn" Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource PillButton}"
                                local:Ui.IsActive="{Binding SleepActive}" Click="Sleep_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE708;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding SleepLabel}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Off" Click="SleepOff_Click"/>
                                    <Separator/>
                                    <MenuItem Header="5 minutes" Tag="5" Click="SleepMinutes_Click"/>
                                    <MenuItem Header="10 minutes" Tag="10" Click="SleepMinutes_Click"/>
                                    <MenuItem Header="15 minutes" Tag="15" Click="SleepMinutes_Click"/>
                                    <MenuItem Header="30 minutes" Tag="30" Click="SleepMinutes_Click"/>
                                    <MenuItem Header="45 minutes" Tag="45" Click="SleepMinutes_Click"/>
                                    <MenuItem Header="60 minutes" Tag="60" Click="SleepMinutes_Click"/>
                                    <Separator/>
                                    <MenuItem Header="End of chapter" Click="SleepChapter_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>

                    <!-- chapters -->
                    <StackPanel Margin="0,26,0,0" Visibility="{Binding ShowChapters, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{Binding ChaptersLabel}" Style="{StaticResource SectionLabel}"/>
                        <ListBox x:Name="ChaptersList" ItemsSource="{Binding ChapterRows}" ItemContainerStyle="{StaticResource PlainItem}"
                                 MaxHeight="250" Background="Transparent" BorderThickness="0" Margin="0,8,0,0" Focusable="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="InnerList_Wheel"/>
                    </StackPanel>

                    <!-- bookmarks -->
                    <StackPanel Margin="0,26,0,0">
                        <Border BorderBrush="#26FFFFFF" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                            <Grid>
                                <TextBlock Text="BOOKMARKS" Style="{StaticResource SectionLabel}"/>
                                <Button Style="{StaticResource PillButton}" HorizontalAlignment="Right" Padding="12,4"
                                        Content="+ Add" ToolTip="Add bookmark (B)" Click="AddBookmark_Click"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="No bookmarks yet." FontFamily="Georgia" FontStyle="Italic" FontSize="12"
                                   Foreground="{StaticResource DimBrush}" Margin="0,10,0,0"
                                   Visibility="{Binding HasNoBookmarks, Converter={StaticResource BoolVis}}"/>
                        <ItemsControl ItemsSource="{Binding Bookmarks}" Margin="0,8,0,0"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- toast -->
        <Border Grid.ColumnSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24"
                Background="#F01B1E26" BorderBrush="#2EFFFFFF" BorderThickness="1" CornerRadius="18" Padding="18,9"
                IsHitTestVisible="False" Visibility="{Binding Toast, Converter={StaticResource NotNullToVis}}">
            <TextBlock Text="{Binding Toast}" FontSize="12.5"/>
        </Border>
    </Grid>
</Window>
