<Window x:Class="AudiobookPlayer.BookmarkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add bookmark" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource InkBrush}" Foreground="{StaticResource PaperBrush}" FontFamily="Segoe UI">
    <StackPanel Margin="26,22,26,24">
        <TextBlock Text="Add bookmark" FontFamily="Georgia" FontStyle="Italic" FontSize="22"/>

        <TextBlock Text="TITLE" Style="{StaticResource SectionLabel}" Margin="0,18,0,6"/>
        <TextBox x:Name="TitleBox" Style="{StaticResource DarkTextBox}"/>

        <TextBlock Text="NOTE (OPTIONAL)" Style="{StaticResource SectionLabel}" Margin="0,14,0,6"/>
        <TextBox x:Name="NoteBox" Style="{StaticResource DarkTextBox}" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="72" MaxHeight="140" VerticalScrollBarVisibility="Auto"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" Style="{StaticResource GhostBtn}" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Save" Style="{StaticResource GoldBtn}" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
