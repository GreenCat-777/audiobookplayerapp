<Window x:Class="AudiobookPlayer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AudiobookPlayer"
        Title="Settings" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource InkBrush}" Foreground="{StaticResource PaperBrush}" FontFamily="Segoe UI">
    <StackPanel Margin="30,26,30,28">

        <TextBlock Text="Settings" FontFamily="Georgia" FontStyle="Italic" FontSize="26"/>

        <TextBlock Text="PLAYBACK" Style="{StaticResource SectionLabel}" Margin="0,24,0,10"/>

        <TextBlock Text="Skip buttons" FontSize="13" Margin="0,0,0,8"/>
        <WrapPanel>
            <RadioButton x:Name="Skip10" GroupName="skip" Content="10 s" Style="{StaticResource PillToggle}" Checked="Skip_Checked" Tag="10"/>
            <RadioButton x:Name="Skip15" GroupName="skip" Content="15 s" Style="{StaticResource PillToggle}" Checked="Skip_Checked" Tag="15"/>
            <RadioButton x:Name="Skip30" GroupName="skip" Content="30 s" Style="{StaticResource PillToggle}" Checked="Skip_Checked" Tag="30"/>
        </WrapPanel>

        <TextBlock Text="Rewind when resuming after a break" FontSize="13" Margin="0,12,0,8"/>
        <WrapPanel>
            <RadioButton x:Name="Rew0" GroupName="rew" Content="Off" Style="{StaticResource PillToggle}" Checked="Rewind_Checked" Tag="0"/>
            <RadioButton x:Name="Rew3" GroupName="rew" Content="3 s" Style="{StaticResource PillToggle}" Checked="Rewind_Checked" Tag="3"/>
            <RadioButton x:Name="Rew5" GroupName="rew" Content="5 s" Style="{StaticResource PillToggle}" Checked="Rewind_Checked" Tag="5"/>
            <RadioButton x:Name="Rew10" GroupName="rew" Content="10 s" Style="{StaticResource PillToggle}" Checked="Rewind_Checked" Tag="10"/>
            <RadioButton x:Name="Rew15" GroupName="rew" Content="15 s" Style="{StaticResource PillToggle}" Checked="Rewind_Checked" Tag="15"/>
            <RadioButton x:Name="Rew30" GroupName="rew" Content="30 s" Style="{StaticResource PillToggle}" Checked="Rewind_Checked" Tag="30"/>
        </WrapPanel>

        <ToggleButton x:Name="PerBookToggle" Content="Remember playback speed per book" Style="{StaticResource PillToggle}"
                      HorizontalAlignment="Left" Margin="0,12,0,0" Click="Toggle_Click"/>

        <TextBlock Text="WINDOW" Style="{StaticResource SectionLabel}" Margin="0,22,0,10"/>
        <WrapPanel>
            <ToggleButton x:Name="TrayToggle" Content="Show tray icon" Style="{StaticResource PillToggle}" Click="Toggle_Click"/>
            <ToggleButton x:Name="CloseTrayToggle" Content="Closing the window keeps playing in the tray" Style="{StaticResource PillToggle}" Click="Toggle_Click"/>
        </WrapPanel>

        <TextBlock Text="LIBRARY" Style="{StaticResource SectionLabel}" Margin="0,22,0,10"/>
        <TextBlock x:Name="LibraryText" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource DimBrush}"
                   TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>
        <WrapPanel>
            <Button Content="Change..." Style="{StaticResource PillButton}" Margin="0,0,6,0" Click="Change_Click"/>
            <Button Content="Rescan" Style="{StaticResource PillButton}" Margin="0,0,6,0" Click="Rescan_Click"/>
            <Button Content="Open data folder" Style="{StaticResource PillButton}" Click="DataFolder_Click"/>
        </WrapPanel>

        <Button Content="Done" Style="{StaticResource GoldBtn}" HorizontalAlignment="Right" Margin="0,26,0,0" IsDefault="True" Click="Done_Click"/>
    </StackPanel>
</Window>
